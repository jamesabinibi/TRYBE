# ==========================================
# 1. DATABASE OPTIONS (Pick ONE)
# ==========================================
# OPTION A: 100% Free PostgreSQL (Recommended: Neon.tech or Supabase Free Tier - $0/mo)
# Simply paste the connection string from your Supabase / Neon / Railway project:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require"

# OPTION B: AWS RDS (Current expensive setup: ~$18-$22/month + $3.65 IPv4 fee)
# AWS_DB_HOST=gryndee-db.cevskqcic97b.us-east-1.rds.amazonaws.com
# AWS_DB_PORT=5432
# AWS_DB_USER=postgres
# AWS_DB_PASSWORD=
# AWS_DB_NAME=postgres

# ==========================================
# 2. IMAGE STORAGE OPTIONS (Pick ONE)
# ==========================================
# OPTION A: Cloudinary (100% Free - 25GB managed storage & CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPTION B: Cloudflare R2 (100% Free - 10GB storage, $0 egress bandwidth charges!)
# AWS_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# AWS_REGION="auto"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=gryndee-uploads

# OPTION C: AWS S3 (Current setup)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ==========================================
# 3. EMAIL SMTP OPTIONS (Pick ONE)
# ==========================================
# OPTION A: Resend or Brevo (Free tier: 3,000 to 9,000 free emails/mo)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxx
# SMTP_SECURE=true
# SMTP_FROM="Gryndee <noreply@yourdomain.com>"

# OPTION B: AWS SES (Current setup - negligible cost < $0.10/mo)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Gryndee <noreply@gryndee.com>"

# ==========================================
# 4. GENERAL APP SETTINGS
# ==========================================
JWT_SECRET="super-secret-key-change-this"
GEMINI_API_KEY=
SUPERADMIN_PASSWORD=

# App URL (replace with your custom domain or Render/Railway URL)
APP_URL="https://pa6brvdnhc.us-east-1.awsapprunner.com"
VITE_APP_URL="https://pa6brvdnhc.us-east-1.awsapprunner.com"
VITE_API_URL="https://pa6brvdnhc.us-east-1.awsapprunner.com"

# Payment Gateway (Paystack)
